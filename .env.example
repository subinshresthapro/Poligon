# Copy this to .env.local and fill in values.

# Theme default for all visitors: "a" = Indigo (original), "b" = Persimmon × Cobalt
NEXT_PUBLIC_DEFAULT_THEME=a

# Stripe Payment Links (v1 — no custom checkout, just external URLs)
# Create these in your Stripe dashboard and paste the Payment Link URLs here.
# Without these set, the donation buttons will be non-functional (#).
NEXT_PUBLIC_STRIPE_MONTHLY_LINK=
NEXT_PUBLIC_STRIPE_ONETIME_LINK=
